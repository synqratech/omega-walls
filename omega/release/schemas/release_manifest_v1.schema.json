{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.omegawalls.io/release/release_manifest_v1.schema.json",
  "title": "Omega Walls Enterprise Release Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release",
    "channel",
    "git_commit",
    "build_id",
    "created_utc",
    "artifacts",
    "contracts",
    "packs",
    "compatibility"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "release": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "channel": {
      "enum": [
        "candidate",
        "stable",
        "lts"
      ]
    },
    "git_commit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{7,64}|unknown)$"
    },
    "build_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/artifact"
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api",
        "config_schema",
        "runtime_state_schema",
        "control_plane_schema",
        "license_schema"
      ],
      "properties": {
        "api": {
          "type": "string",
          "pattern": "^v[0-9]+$"
        },
        "config_schema": {
          "type": "integer",
          "minimum": 1
        },
        "runtime_state_schema": {
          "type": "integer",
          "minimum": 1
        },
        "control_plane_schema": {
          "type": "integer",
          "minimum": 1
        },
        "license_schema": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "packs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "vision"
      ],
      "properties": {
        "policy": {
          "type": "string",
          "minLength": 1
        },
        "vision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upgrade_from",
        "rollback_to"
      ],
      "properties": {
        "upgrade_from": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rollback_to": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "irreversible_state_migrations": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "notes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "release_notes": {
          "type": "string",
          "minLength": 1
        },
        "upgrade_notes": {
          "type": "string",
          "minLength": 1
        },
        "rollback_notes": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "oci_image",
            "wheel",
            "sdist",
            "helm_chart",
            "airgap_bundle",
            "file"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "(^|[:/])latest(?:$|[@/])"
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "oci_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "oci_image"
              }
            }
          },
          "then": {
            "required": [
              "oci_digest"
            ]
          }
        }
      ]
    }
  }
}
