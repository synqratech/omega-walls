{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.omegawalls.io/licensing/license_keyring_v1.schema.json",
  "title": "Omega Walls Enterprise License Public-Key Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "keys"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key_id",
          "algorithm",
          "public_key",
          "status",
          "usage"
        ],
        "properties": {
          "key_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "algorithm": {
            "const": "Ed25519"
          },
          "public_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "status": {
            "enum": [
              "active",
              "retired",
              "revoked"
            ]
          },
          "usage": {
            "enum": [
              "production",
              "test"
            ]
          }
        }
      }
    }
  }
}
