include LICENSE
include README.md
include README_PYPI.md
include pyproject.toml
recursive-include packaging *.yml *.yaml *.json *.md Caddyfile .env.example

recursive-include omega *.py *.yml *.json
prune omega/enterprise
prune omega/orchestrator
prune omega_walls_enterprise
recursive-include release *.md *.yml *.json

prune .venv
prune .venv-linux
prune .vendor
prune .vendor_pytest
prune artifacts
prune data
prune cloud
prune docs
prune enterprise
prune internal_data
prune notebooks
prune redteam
prune schemas
prune tests
prune e5-small-v2
prune multilingual-e5-small
prune deberta-v3-base

exclude API_OpenAI.txt
exclude partner_policy_pack_latest.zip
exclude partner_policy_pack_v1_20260323.zip
exclude model.safetensors
exclude tokenizer.json
exclude tokenizer_config.json
exclude vocab.json
exclude merges.txt
exclude config.json
exclude generation_config.json

exclude pyproject.enterprise.toml
exclude Dockerfile.enterprise
exclude Dockerfile.enterprise.vision
exclude omega/config/resources/profiles/prod_enterprise.yml
exclude omega/config/resources/profiles/prod_vision_enterprise.yml
global-exclude *.py[cod]
exclude pyproject.enterprise.toml
exclude Dockerfile.enterprise
exclude Dockerfile.enterprise.vision
exclude omega/config/resources/profiles/prod_enterprise.yml
exclude omega/config/resources/profiles/prod_vision_enterprise.yml
global-exclude __pycache__
exclude pyproject.enterprise.toml
exclude Dockerfile.enterprise
exclude Dockerfile.enterprise.vision
exclude omega/config/resources/profiles/prod_enterprise.yml
exclude omega/config/resources/profiles/prod_vision_enterprise.yml
global-exclude .DS_Store
